{
  "name": "hatchly-server-2026",
  "version": "1.0.0",
  "description": "Hatchly backend — Express + TypeScript + Socket.IO",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "dev:kill": "npx kill-port 5000 && npm run dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed:game-items": "tsx src/scripts/seedGameItems.ts",
    "seed:fish": "tsx src/scripts/seedFishFromTxt.ts",
    "seed:bugs": "tsx src/scripts/seedBugFromTxt.ts",
    "seed:bug-sets": "tsx src/scripts/seedBugFromTxt.ts",
    "seed:bug-images": "tsx src/scripts/seedBugFromTxt.ts --generate-images --concurrency=6",
    "seed:crafting": "tsx src/scripts/seedCraftingFromTxt.ts",
    "seed:crafting-images": "tsx src/scripts/seedCraftingFromTxt.ts --generate-images --concurrency=6",
    "seed:crafting-recipes": "tsx src/scripts/seedCraftingRecipeItems.ts",
    "seed:loot-recipes": "tsx src/scripts/addCraftRecipesToLoot.ts",
    "seed:seeds": "tsx src/scripts/seedSeedsFromTxt.ts",
    "seed:seed-images": "tsx src/scripts/seedSeedsFromTxt.ts --generate-images --concurrency=6",
    "seed:cooking": "tsx src/scripts/seedCookingFromTxt.ts",
    "seed:cooking-recipes": "tsx src/scripts/seedCookingFromTxt.ts",
    "seed:cooking-images": "tsx src/scripts/seedCookingFromTxt.ts --generate-images --concurrency=16",
    "seed:storage": "tsx src/scripts/seedStorageItem.ts",
    "bake:scenery": "tsx src/scripts/bakeScenery.ts",
    "migrate:recipe-type": "tsx src/scripts/migrateRecipeType.ts",
    "apply:farming-seed-shop": "tsx src/scripts/applyFarmingSeedShopUnlocks.ts",
    "rebalance:farming-economy": "tsx src/scripts/rebalanceFarmingEconomy.ts",
    "reset:quests": "tsx src/scripts/resetQuests.ts",
    "seed:starter": "tsx src/scripts/seedStarterContent.ts",
    "seed:halloween": "tsx src/scripts/seedHalloweenContent.ts",
    "seed:halloween-sets": "tsx src/scripts/seedHalloweenSetPieces.ts",
    "seed:mining": "tsx src/scripts/seedMiningFromTxt.ts",
    "seed:mining-images": "tsx src/scripts/seedMiningFromTxt.ts --generate-images --concurrency=8",
    "seed:goal-icons": "tsx src/scripts/seedGoalIconItems.ts",
    "seed:marketing-pets": "tsx src/scripts/seedMarketingPets.ts",
    "generate:random-pets": "tsx src/scripts/generateRandomPets.ts",
    "smoke:quests": "tsx src/scripts/smokeQuests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@google/genai": "^1.41.0",
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "expo-server-sdk": "^3.7.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "get-image-colors": "^4.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "twilio": "^5.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.10",
    "@types/sharp": "^0.31.1",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
